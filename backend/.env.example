# Upstash Redis Configuration (Recommended)
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Redis Cloud Configuration (Legacy - deprecated)
# REDIS_HOST=redis-xxxxx.cloud.rlrc.net
# REDIS_PORT=xxxxx
# REDIS_PASSWORD=your-redis-password
# REDIS_USERNAME=default

# Redis Local Development (for development without cloud)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# (no password needed for local)
